<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <!-- Top App Bar with Auth Info -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drug-Likeness Checker"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivUserAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="User Avatar"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Guest"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAuth"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Navigation Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="#666666">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan &amp; Check" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saved History" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Content Views -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: SEARCH & CHECKER -->
        <ScrollView
            android:id="@+id/layoutCheckerTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Search & Scan Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter or Scan Drug Name (e.g. Aspirin)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDrugName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:singleLine="true" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSearch"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Check Drug"
                                app:icon="@android:drawable/ic_menu_search" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnScanBox"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Scan Box"
                                app:icon="@android:drawable/ic_menu_camera" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Loading Indicator -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="24dp"
                    android:visibility="gone" />

                <!-- Error Text -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="#D32F2F"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- RESULTS CONTAINER -->
                <LinearLayout
                    android:id="@+id/layoutResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Compound Identity Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvResName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aspirin"
                                android:textColor="@android:color/black"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvResFormula"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Formula: C9H8O4"
                                android:textColor="#555555"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvResIupac"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="IUPAC: 2-acetoxybenzoic acid"
                                android:textColor="#666666"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvResSmiles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="SMILES: CC(=O)Oc1ccccc1C(=O)O"
                                android:textColor="#1976D2"
                                android:textSize="12sp" />

                            <ImageView
                                android:id="@+id/ivStructure"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:layout_marginTop="12dp"
                                android:background="#FAFAFA"
                                android:contentDescription="2D Structure"
                                android:scaleType="fitCenter" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Physicochemical Properties Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Physicochemical Descriptors (bioKT)"
                                android:textColor="@android:color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TableLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:stretchColumns="1">

                                <TableRow android:paddingVertical="3dp">
                                    <TextView android:text="Molecular Weight (MW): " android:textStyle="bold" android:textSize="13sp"/>
                                    <TextView android:id="@+id/tvMw" android:text="180.16 Da" android:textSize="13sp"/>
                                </TableRow>

                                <TableRow android:paddingVertical="3dp">
                                    <TextView android:text="LogP (Crippen): " android:textStyle="bold" android:textSize="13sp"/>
                                    <TextView android:id="@+id/tvLogP" android:text="1.31" android:textSize="13sp"/>
                                </TableRow>

                                <TableRow android:paddingVertical="3dp">
                                    <TextView android:text="H-Bond Donors (HBD): " android:textStyle="bold" android:textSize="13sp"/>
                                    <TextView android:id="@+id/tvHbd" android:text="1" android:textSize="13sp"/>
                                </TableRow>

                                <TableRow android:paddingVertical="3dp">
                                    <TextView android:text="H-Bond Acceptors (HBA): " android:textStyle="bold" android:textSize="13sp"/>
                                    <TextView android:id="@+id/tvHba" android:text="4" android:textSize="13sp"/>
                                </TableRow>

                                <TableRow android:paddingVertical="3dp">
                                    <TextView android:text="TPSA (Å²): " android:textStyle="bold" android:textSize="13sp"/>
                                    <TextView android:id="@+id/tvTpsa" android:text="63.60" android:textSize="13sp"/>
                                </TableRow>

                            </TableLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipLipinski"
                                    style="@style/Widget.Material3.Chip.Assist.Elevated"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="Lipinski: PASS" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipVeber"
                                    style="@style/Widget.Material3.Chip.Assist.Elevated"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Veber: PASS" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ADMET Profile Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ADMET Profile"
                                android:textColor="@android:color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.chip.ChipGroup
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipOralBio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Oral Bioavailability: High" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipBbb"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="BBB Penetration: Yes" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipHerg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="hERG Risk: Low" />

                            </com.google.android.material.chip.ChipGroup>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- DrugMLPredictor ML Analysis Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DrugMLPredictor Predictions"
                                android:textColor="@android:color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMlPredictions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:lineSpacingExtra="4dp"
                                android:text="• Activity: active (72%)\n• Toxicity: class_I_low (81%)\n• hERG Risk: non-inhibitor (84%)"
                                android:textColor="#333333"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Save Drug Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveDrug"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:text="Save Drug to History"
                        app:icon="@android:drawable/ic_menu_save" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- TAB 2: SAVED HISTORY & COMPARISON -->
        <LinearLayout
            android:id="@+id/layoutSavedTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSavedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Select 2 drugs to compare side-by-side"
                android:textColor="#555555"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSavedDrugs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="80dp" />

            <!-- Bottom Floating Comparison Bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCompareBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvCompareStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2 Drugs Selected for Compare"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRunCompare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compare" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
